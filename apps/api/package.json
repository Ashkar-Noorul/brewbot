{
  "name": "@brewbot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "ingest": "tsx --env-file=../../.env src/scripts/ingest.ts",
    "smoke": "tsx --env-file=../../.env src/scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "tsx --env-file=../../.env src/evals/run.ts",
    "seed:demo": "tsx --env-file=../../.env src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@google/genai": "^3.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
