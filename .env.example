# --- Providers -----------------------------------------------------------------
# Chat:       "gemini" (free tier) | "anthropic" (Claude API) | "bedrock" (Claude on AWS)
# Embeddings: "gemini" (free tier) | "bedrock" (Titan V2)
# After changing EMBEDDING_PROVIDER, run "npm run ingest" again.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com (keep the project unbilled to stay on the free tier)
GEMINI_API_KEY=

# Claude API: key from https://platform.claude.com
# ANTHROPIC_API_KEY=

# AWS (Bedrock): credentials come from "aws configure", not from this file
AWS_REGION=us-east-1

# Optional overrides. Defaults per provider:
#   gemini    -> gemini-3.5-flash-lite,        embeddings gemini-embedding-2
#   anthropic -> claude-sonnet-5-5
#   bedrock   -> anthropic.claude-sonnet-5-5,  embeddings amazon.titan-embed-text-v2:0
# CHAT_MODEL=
# EMBEDDING_MODEL=
# How hard the model thinks before answering: low (fast, cheap) | medium | high
# CHAT_EFFORT=low

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgres://brewbot:brewbot@localhost:5433/brewbot

# --- Retrieval tuning ----------------------------------------------------------
RETRIEVAL_TOP_K=5
# Below this cosine similarity the question is treated as "not covered by our docs".
# Model-specific: ~0.6 for gemini-embedding-2, ~0.35 for Titan V2. Re-tune when you switch.
LOW_CONFIDENCE_THRESHOLD=0.6

# --- Guardrails and handoff ----------------------------------------------------
# Max chat messages per visitor IP per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20
# Optional: Slack incoming-webhook URL (or any URL accepting {"text": ...}) to alert staff of new tickets.
HANDOFF_WEBHOOK_URL=

PORT=3001
CORS_ORIGIN=*
